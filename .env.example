# Public website tracking. Direct GA4 is used; keep GTM disabled.
NEXT_PUBLIC_GA4_ID=G-B7BTM2RSBE
NEXT_PUBLIC_GTM_ID=

# Private reporting for the admin dashboard. Never expose these as NEXT_PUBLIC variables.
# Keep the private key blank in this template. Set it only in a local or Vercel secret.
GOOGLE_ANALYTICS_PROPERTY_ID=551503536
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://caautobody.com.au/
GOOGLE_SERVICE_ACCOUNT_EMAIL=caautobody-analytics-reader@caautobody-analytics-reader.iam.gserviceaccount.com
