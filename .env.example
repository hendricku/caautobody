SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@caautobody.com.au
SMTP_PASSWORD=
